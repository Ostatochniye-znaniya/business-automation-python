APP_NAME="Остаточные знания — Московский Политех"
APP_ENV=development
DEBUG=false
API_PREFIX=/api
DATABASE_URL=mysql+asyncmy://knowledge:change_me@db:3306/knowledge_app
LOG_LEVEL=INFO
SERVE_FRONTEND=false
DEMO_DATA=false
# Optional existing user ID for local development without demo data
# DEV_USER_ID=1
MYSQL_DATABASE=knowledge_app
MYSQL_USER=knowledge
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

# Ports exposed on localhost by Docker Compose
APP_PORT=8000
BACKEND_PORT=8001
MYSQL_PORT=3306

# Files are stored in the report_files volume in Docker.
REPORT_STORAGE_DIR=storage/reports
MAX_REPORT_BYTES=20971520

# Optional RFC 7662 integration; leave empty until university SSO is available.
# AUTH_INTROSPECTION_URL=https://identity.example/introspect
# AUTH_INTROSPECTION_CLIENT_ID=
# AUTH_INTROSPECTION_CLIENT_SECRET=
